{
  "name": "aiopsome/agentic-payment-x402-lunar",
  "type": "project",
  "description": "Agentic Pay for Lunar — crypto and x402 payment driver for Lunar (human wallet checkout + AI agent payments via x402).",
  "keywords": ["lunarphp", "laravel", "ecommerce", "e-commerce", "headless", "store", "shop", "cart", "crypto", "usdc", "x402", "agentic-commerce", "agentic-pay"],
  "license": "MIT",
  "authors": [
    {
      "name": "AIOpsome",
      "homepage": "https://aiopsome.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "lunarphp/core": "^1.0"
  },
  "require-dev": {
    "orchestra/testbench": "^9.0",
    "pestphp/pest": "^3.0",
    "pestphp/pest-plugin-laravel": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "Lunar\\CryptoPayments\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Lunar\\CryptoPayments\\Tests\\": "tests/"
    }
  },
  "extra": {
    "lunar": {
      "name": "Agentic Pay"
    },
    "laravel": {
      "providers": [
        "Lunar\\CryptoPayments\\CryptoPaymentsServiceProvider"
      ]
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
